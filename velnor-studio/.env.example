# Optional AI provider. Leave both blank for clearly labeled demo mode.
ANTHROPIC_API_KEY=
# Known model alias; change if your Anthropic account uses a different model.
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: choose anthropic or openai when the matching key is configured.
# AI_PROVIDER=anthropic
# If an AI key is configured on a public deployment, set a strong access code too.
# ACCESS_CODE=replace-with-a-long-random-passphrase
