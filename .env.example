# Copy this file to ".env" and fill in ONE provider. Never commit ".env".
# With no key set, VELNOR STUDIO runs in clearly labeled Demo mode.

# --- Option A: Anthropic (Claude) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Option B: OpenAI ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Force a provider if both keys are set: anthropic | openai
# AI_PROVIDER=

# Optional but recommended once the app is public:
# visitors must type this code before the app will call your paid AI key.
# ACCESS_CODE=

# Optional
# PORT=3000
